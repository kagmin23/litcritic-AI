# ============================================================
# ViSEF Multi-Agent — Biến môi trường (Vite)
# Sao chép file này thành `.env` rồi điền giá trị thật.
# ============================================================

# Google Gemini 1.5 Flash — API key FREE
# Lấy tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Supabase — Project URL & anon public key
# Lấy tại: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tự động đăng xuất khi không hoạt động (phút).
# Để trống để dùng mặc định: 30 phút (student/teacher), 15 phút (admin).
VITE_IDLE_TIMEOUT_MIN=30
VITE_IDLE_TIMEOUT_ADMIN_MIN=15
# Thời gian hiện cảnh báo trước khi đăng xuất (giây).
VITE_IDLE_WARNING_SEC=60
